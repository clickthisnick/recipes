{
    "name": "recipes",
    "version": "1.0.0",
    "description": "Personal recipes and kitchen tools",
    "scripts": {
        "build": "tsc",
        "postbuild": "node scripts/validate-recipes.js",
        "dev": "vite",
        "start": "node scripts/serve.js",
        "pretest": "npm run build",
        "test": "node --experimental-detect-module --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
        "lint": "eslint .",
        "audit-amazon": "node scripts/audit-products.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/clickthisnick/recipes.git"
    },
    "author": "",
