{
    // Type-checks the app's JavaScript from its JSDoc annotations. Nothing is emitted:
    // browsers run src/file.js as-is.
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["src/file.js"]
}
