{
    "version": "0.2.0",
    "configurations": [
        {
            "command": "npm start",
            "name": "Serve the site",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open the site",
            "url": "http://localhost:3000/",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
